APP_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=techbus_dev
DB_USER=techbus_dev_app
DB_PASSWORD=
DB_MIGRATION_USER=techbus_dev_migrator
DB_MIGRATION_PASSWORD=
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Internal event processing only; does not enable WhatsApp sending.
EVOLUTION_PROCESS_ENABLED=false

# Periodic consultations/reminders/closure; sending still requires Evolution opt-in.
OPERATIONS_SCHEDULER_ENABLED=false

# Google Maps server key. Keep the real value only in the private .env file.
GOOGLE_MAPS_API_KEY=
