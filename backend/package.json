{
  "name": "techbus-backend",
  "version": "0.0.1",
  "description": "Base local do backend TechBus",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "auth:bootstrap": "ts-node src/access/cli/auth-bootstrap.ts",
    "auth:recover-admin": "ts-node src/access/cli/auth-recover-admin.ts",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file=.env dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --selectProjects unit --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:integration": "jest --selectProjects integration --runInBand",
    "migration:show": "ts-node src/infrastructure/database/migrate.ts show",
    "migration:run": "ts-node src/infrastructure/database/migrate.ts run",
    "migration:revert": "ts-node src/infrastructure/database/migrate.ts revert",
    "gemini:smoke": "node scripts/gemini-smoke.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.31",
    "rxjs": "7.8.1",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/core": "11.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.2",
    "globals": "17.0.0",
    "jest": "30.0.0",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.3",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.46.1",
    "@types/pg": "8.15.5"
  },
  "engines": {
    "node": "24.22.1",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0"
}
